APP_NAME="Shop Builder"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Central host: the admin panel + marketing site. Stores live on subdomains of
# it ({slug}.shop.sasho-dev.com). Use a DEDICATED (sub)domain — not a domain
# that already serves another site.
APP_URL=https://shop.sasho-dev.com
APP_CENTRAL_DOMAIN=shop.sasho-dev.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# From cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sashodeo_shop
DB_USERNAME=sashodeo_shop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=sb_session
# Leading dot + central domain, so a signed-in owner stays signed in on their
# store subdomain. Must match APP_CENTRAL_DOMAIN.
SESSION_DOMAIN=.shop.sasho-dev.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No queued jobs and no scheduler in this app — sync needs no worker/cron.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Inertia SSR stays off (there is no SSR bundle).
INERTIA_SSR_ENABLED=false

# A cPanel email account (Email Accounts → Connect Devices → SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.sasho-dev.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@sasho-dev.com
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@sasho-dev.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe — leave blank to keep checkout on pay-on-delivery and the plan picker
# read-only. Fill to enable card payments + subscription billing.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_STOREFRONT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Operator panel (/super-admin). CHANGE THESE for production — the bundled
# default is public. Set a plain password here, or a bcrypt hash in
# SUPER_ADMIN_PASSWORD_HASH: php -r "echo password_hash('…', PASSWORD_BCRYPT);"
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=

VITE_APP_NAME="${APP_NAME}"
