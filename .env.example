APP_NAME="Shop Builder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://shop-builder.localhost:8000

# Root domain for tenant subdomains (e.g. acme.shop-builder.localhost).
# Browsers resolve *.localhost to 127.0.0.1 automatically — no hosts file needed.
APP_CENTRAL_DOMAIN=shop-builder.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop_builder
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=sb_session
# Set to a leading-dot parent of your central domain (e.g. .shop-builder.localhost)
# so a signed-in store owner is recognised on their store subdomain.
SESSION_DOMAIN=.shop-builder.localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe — the PLATFORM's own account, for subscription billing (Cashier) only.
# Storefront card payments use each store's own keys, connected from the store
# admin. Also settable from the operator panel. Leave blank to keep the plan
# picker read-only.
STRIPE_KEY=
STRIPE_SECRET=
# Cashier's subscription webhook (endpoint: /billing/webhook)
STRIPE_WEBHOOK_SECRET=
# Fallback secret for the central /stripe/webhook route; per-store webhook
# secrets (set in each store's admin) take precedence.
STRIPE_STOREFRONT_WEBHOOK_SECRET=
# Recurring Price IDs for the platform plans (see config/plans.php)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Platform operator panel (/super-admin) — one login, separate from the `users`
# table. Ships with a working default (sasho-dev + a bundled password hash);
# override in production. Set SUPER_ADMIN_PASSWORD to a plain string, or
# SUPER_ADMIN_PASSWORD_HASH to a bcrypt hash:
#   php -r "echo password_hash('your-secret', PASSWORD_BCRYPT);"
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=

VITE_APP_NAME="${APP_NAME}"
